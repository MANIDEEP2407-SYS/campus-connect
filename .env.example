# Copy to .env.local and fill in. Placeholders only — never commit real secrets.

# --- Supabase (local: printed by `npm run db:start`; hosted: Project Settings → API) -------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# Server-only. Used by scripts/seed.mts and by the CampusShield scan worker (src/lib/supabase/admin.ts).
# Never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Public site URL (used for OAuth and email redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Microsoft Entra ID (Amrita Microsoft 365) sign-in ------------------------------------------
# The OAuth client id/secret are configured in SUPABASE AUTH (provider "azure"), not in this app:
#   hosted: Supabase Dashboard → Authentication → Providers → Azure
#   local:  supabase/config.toml [auth.external.azure] + these env vars for the Supabase CLI:
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=replace-with-entra-application-client-id
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=replace-with-entra-client-secret-value
SUPABASE_AUTH_EXTERNAL_AZURE_URL=https://login.microsoftonline.com/replace-with-amrita-tenant-id/v2.0
# App side: show the Microsoft button, and the approved tenant id (GUID) checked after sign-in.
NEXT_PUBLIC_MICROSOFT_AUTH_ENABLED=false
MICROSOFT_TENANT_ID=
# Email/password sign-in is for development only. It is always available when NODE_ENV != production;
# set this to true only for local production builds / demos. Also disable the Email provider in
# Supabase Auth for real production deployments.
ALLOW_DEV_LOGIN=false

# --- CampusShield (AI-assisted moderation) -------------------------------------------------------
# openai | mock | none. "mock" is a development keyword heuristic and is always labelled as such.
MODERATION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT_MS=5000
# Policy thresholds on model scores (0–1)
SHIELD_THRESHOLD_REVIEW=0.45
SHIELD_THRESHOLD_HIGH=0.75
SHIELD_THRESHOLD_CRITICAL=0.9
# Protects /api/shield/sweep (queued scans + retention). Vercel Cron sends it as a Bearer token.
CRON_SECRET=replace-with-a-long-random-string

# --- Demo data ----------------------------------------------------------------------------------
# Shared password for the fictional demo accounts created by `npm run db:seed`.
# Avoid '#' in unquoted values: Node's --env-file treats it as the start of a comment.
DEMO_PASSWORD=CampusDemo-2026
